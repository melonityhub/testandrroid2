{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_ext_name__",
  "version": "1.3.6",
  "description": "__MSG_ext_desc__",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "identity"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "__MSG_cmd_open_panel__"
    }
  },
  "host_permissions": [
    "*://*.primevideo.com/*",
    "*://*.amazon.com/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.de/*",
    "*://*.pv-cdn.net/*",
    "*://cf-timedtext.aux.pv-cdn.net/*",
    "*://translate.googleapis.com/*",
    "*://api.dictionaryapi.dev/*",
    "*://api.datamuse.com/*",
    "*://*.youtube.com/*",
    "*://*.netflix.com/*",
    "https://*.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://prime-vocab-mobile.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.amazon.com/v/*",
        "*://*.amazon.com/dp/*",
        "*://*.amazon.com/gp/product/*",
        "*://*.amazon.co.uk/gp/video/*",
        "*://*.amazon.co.uk/dp/*",
        "*://*.amazon.co.uk/gp/product/*",
        "*://*.amazon.de/gp/video/*",
        "*://*.amazon.de/dp/*",
        "*://*.amazon.de/gp/product/*",
        "*://*.youtube.com/*",
        "*://*.netflix.com/*"
      ],
      "js": [
        "content/intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.amazon.com/v/*",
        "*://*.amazon.com/dp/*",
        "*://*.amazon.com/gp/product/*",
        "*://*.amazon.co.uk/gp/video/*",
        "*://*.amazon.co.uk/dp/*",
        "*://*.amazon.co.uk/gp/product/*",
        "*://*.amazon.de/gp/video/*",
        "*://*.amazon.de/dp/*",
        "*://*.amazon.de/gp/product/*"
      ],
      "css": [
        "content/inject.css"
      ],
      "js": [
        "content/utils_common.js",
        "content/phrasal_verbs.js",
        "content/idioms.js",
        "content/adapters/AmazonAdapter.js",
        "content/inject_common.js",
        "content/inject_amazon.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "content/inject.css"
      ],
      "js": [
        "content/utils_common.js",
        "content/phrasal_verbs.js",
        "content/idioms.js",
        "content/adapters/YoutubeAdapter.js",
        "content/inject_common.js",
        "content/inject_youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "css": [
        "content/inject.css"
      ],
      "js": [
        "content/utils_common.js",
        "content/phrasal_verbs.js",
        "content/idioms.js",
        "content/adapters/NetflixAdapter.js",
        "content/inject_common.js",
        "content/inject_netflix.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://prime-vocab-mobile.vercel.app/oauth_callback*"
      ],
      "js": [
        "content/oauth_helper.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_open_panel__"
  },
  "options_ui": {
    "page": "sidepanel/panel.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel/panel.html",
        "sidepanel/*",
        "icons/icon32.png",
        "_locales/*/messages.json",
        "langs/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}